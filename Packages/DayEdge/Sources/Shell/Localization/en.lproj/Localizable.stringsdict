			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Meeting started %lld minute ago</string>
			<key>other</key>
			<string>Meeting started %lld minutes ago</string>
		</dict>
	</dict>
	<key>meeting.starts.minutes</key>
